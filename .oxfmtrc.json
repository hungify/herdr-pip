{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 4,
  "singleQuote": true,
  "bracketSpacing": false,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "quoteProps": "consistent",
  "sortPackageJson": false,
  "ignorePatterns": ["**/*.md", "test/fixtures/**", "pnpm-lock.yaml", "po/**"],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.yml", "**/*.yaml", "**/*.css"],
      "options": {"tabWidth": 2}
    }
  ]
}
