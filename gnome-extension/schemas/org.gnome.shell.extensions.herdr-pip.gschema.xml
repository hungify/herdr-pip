<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.herdr-pip"
          path="/org/gnome/shell/extensions/herdr-pip/">
    <key name="toggle-hotkey" type="as">
      <default><![CDATA[['<Super><Shift>h']]]></default>
      <summary>Toggle the Herdr panel</summary>
    </key>
    <key name="terminal" type="s">
      <default>''</default>
      <summary>Terminal to launch</summary>
      <description>One of foot, ghostty, kitty, ptyxis, gnome-terminal. Empty means auto-detect.</description>
    </key>
    <key name="session" type="s">
      <default>''</default>
      <summary>Herdr session name</summary>
      <description>Passed as herdr --session NAME. Empty means the default session.</description>
    </key>
  </schema>
</schemalist>
